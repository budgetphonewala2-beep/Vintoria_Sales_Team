# Copy to ~/.ai-sales-team/.env (never commit the real file). Everything is optional.

# --- SERP via Bright Data: the main lead source (Google X-ray across LinkedIn, Reddit, Quora, X, FB groups, Upwork ...)
BRIGHTDATA_API_KEY=               # Bright Data → Account settings → API key
BRIGHTDATA_ZONE=serp_api1         # the name of your SERP API zone
HUNT_EVERY_HOURS=2                # autopilot runs serp.py watch this often (0 = off) for the newest posts
HUNT_MAX_QUERIES=12               # queries per watch run (cost: ~12 SERP requests)
# SERP_PROVIDERS=brightdata       # default; other providers (serper, serpapi, brave, apify) only if you add them here

# --- copy quality and sending health
LINT_MIN_SCORE=80                 # email_lint.py score an email needs to pass approve --check (85+ = premium)
BOUNCE_STOP_PCT=2                 # pause cold sends when bounces pass this % (last 14 days)
MAX_TOUCHES_PER_WEEK=4            # per prospect, all channels

# --- lead sources + research
APIFY_TOKEN=                      # console.apify.com → Settings → API & Integrations
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-post-search
APIFY_GOOGLE_ACTOR=apify/google-search-scraper
APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite
APIFY_X_ACTOR=apidojo/tweet-scraper
APIFY_FACEBOOK_ACTOR=apify/facebook-groups-scraper
APIFY_MAPS_ACTOR=compass/crawler-google-places
APIFY_APOLLO_ACTOR=code_crafter/apollo-scraper        # Apollo people search URL → leads
APIFY_LEADS_ACTOR=code_crafter/leads-finder           # Apollo-style filters, no Apollo account
APIFY_PEOPLE_ACTOR=harvestapi/linkedin-profile-search
APIFY_EMPLOYEES_ACTOR=harvestapi/linkedin-company-employees
APIFY_MAX_USD=1.00                # spend cap per actor run
APIFY_MAX_RUNS=8                  # actor runs per hunt
PRODUCTHUNT_TOKEN=                # free developer token: producthunt.com/v2/oauth/applications
# Hacker News needs no key. Reddit works without a key (public JSON) but Apify is steadier.

# --- email finders (waterfall, first verified wins) and verifiers — set any you have
EMAIL_FINDERS=prospeo,findymail,hunter,apollo
PROSPEO_API_KEY=
FINDYMAIL_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
EMAIL_VERIFIERS=millionverifier,zerobounce,neverbounce,hunter
MILLIONVERIFIER_API_KEY=
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=

# --- who you are (used in signatures, invites and compliance checks)
SENDER_NAME=Ravi Sharma
SENDER_EMAIL=ravi@youragency.in
SENDER_ADDRESS=12 MG Road, Pune 411001, India     # required in US cold email (CAN-SPAM)
# Who you are and who you sell to lives in SELLER-PROFILE.json (python skills/sales/scripts/seller_profile.py init)
REPLY_TO=

# --- sending (optional; without it you send yourself and the agent logs it)
SMTP_HOST=smtp.gmail.com          # Google Workspace / Gmail: use an App Password
SMTP_PORT=587                     # 587 = STARTTLS, 465 = SSL
SMTP_USER=ravi@youragency.in
SMTP_PASSWORD=
DAILY_SEND_LIMIT=30               # cap per day across all prospects
SENDING_STARTED=                  # YYYY-MM-DD you started this inbox: ramps 10/day in week 1, +5/week up to the cap
CADENCE_DAYS=3,7,14,28            # follow-ups on these days after email 1 (weekends move to Monday)
SEND_HOURS=09:00-17:00            # queued emails go out only in this window in the PROSPECT's time zone, weekdays
PROSPECT_DEFAULT_TZ=              # e.g. America/New_York when a prospect's location is unknown (default: first target country)
AUTO_SEND=0                       # 1 = autopilot.py tick sends due, approved sequence emails

# --- reading replies (IMAP, read-only) — needed for hands-free sequences
IMAP_HOST=imap.gmail.com          # default: derived from SMTP_HOST
IMAP_PORT=993
IMAP_USER=                        # default SMTP_USER
IMAP_PASSWORD=                    # default SMTP_PASSWORD
AUTO_REPLY=0                      # 1 = answer "let's talk" replies instantly with BOOKING_URL
AUTO_REPLY_CATEGORIES=meeting_request

# --- meetings
TIMEZONE=Asia/Kolkata
WORK_HOURS=10:00-18:00
EXTENDED_HOURS=07:00-23:00        # used only when time zones barely overlap (India <-> US)
WORK_DAYS=Mon-Fri
MEETING_MINUTES=30
BOOKING_URL=https://cal.com/yourname/15min
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# --- instant alerts (fresh leads, replies, bookings) — any of these
TELEGRAM_BOT_TOKEN=               # @BotFather → /newbot
TELEGRAM_CHAT_ID=                 # message your bot, then https://api.telegram.org/bot<token>/getUpdates
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_ON=fresh_leads,replies,bookings

# --- Google PageSpeed Insights (optional key; works without one at low volume)
PAGESPEED_API_KEY=

# --- several sending inboxes: ~/.ai-sales-team/mailboxes.json (python skills/sales/scripts/mailboxes.py example);
#     put each inbox's app password here under the password_env name you chose, e.g.
# PW_RAVI_GETPIXELCRAFT=

# LinkedIn profile scraper for post authors (post_lead.py)
# APIFY_PROFILE_ACTOR=harvestapi/linkedin-profile-scraper
# APIFY_PROFILE_INPUT_KEY=urls
